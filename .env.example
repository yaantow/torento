# ============================================================
#  TORENTO — environment configuration
#  Copy to .env and fill in the values. Never commit .env.
# ============================================================

# ---- Server ----
PORT=3000
# Public base URL of this instance. Used to build the OAuth redirect
# and secure-cookie behaviour. In production set this to your https URL.
APP_URL=http://localhost:3000
# Set to "production" on the droplet so session cookies are Secure + SameSite.
NODE_ENV=development

# ---- Google OAuth (login + Google Drive, one consent) ----
# Create these in Google Cloud Console:
#   1. console.cloud.google.com  ->  create/select a project
#   2. "APIs & Services" -> "Enable APIs" -> enable "Google Drive API"
#      (and "Google Picker API" if you want the folder picker below)
#   3. "OAuth consent screen": External, add your email(s) as Test users,
#      add scopes: openid, email, profile,
#      https://www.googleapis.com/auth/drive.file
#   4. "Credentials" -> "Create OAuth client ID" -> Web application
#   5. Authorized redirect URI must EXACTLY equal APP_URL + /api/auth/callback
#      e.g. http://localhost:3000/api/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional override; if empty it defaults to APP_URL + /api/auth/callback
OAUTH_REDIRECT_URI=

# ---- Security secrets (generate your own — do NOT reuse these) ----
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs the session cookie (JWT). Rotating it logs everyone out.
SESSION_SECRET=
# Encrypts stored Google refresh tokens at rest (AES-256-GCM, 32-byte hex/64 chars).
# Changing it invalidates every stored Drive connection (users re-connect).
TOKEN_ENCRYPTION_KEY=

# ---- Access control (optional) ----
# Comma-separated allowlist of Google emails permitted to sign in.
# Leave empty to allow anyone who completes Google sign-in.
# People you invite to a shared library (via Manage members) can always sign in,
# even if they aren't listed here.
ALLOWED_EMAILS=

# ---- Google Picker (optional) ----
# Browser API key that enables the "Choose a folder" picker so users can
# select an existing Drive folder. If empty, Torento auto-creates and uses
# a folder named by DRIVE_DEFAULT_FOLDER instead.
#   Cloud Console -> Credentials -> Create API key (restrict to Picker API).
GOOGLE_PICKER_API_KEY=
# Name of the auto-created destination folder when no folder is picked.
DRIVE_DEFAULT_FOLDER=Torento

# ---- Storage ----
# Local disk is now only a transient staging buffer: files are uploaded to
# the user's Drive, verified, then removed locally to free droplet space.
DATA_DIR=./data
CACHE_DIR=./cache
# Ceiling for the transient local buffer (staging area), in GB.
CACHE_MAX_GB=28
CACHE_TTL_HOURS=0
MAX_CONCURRENT_TORRENTS=2

# ---- Metadata ----
# TMDB API read token for posters / backdrops / episode data.
TMDB_API_KEY=

# ---- Torrent sources (optional overrides) ----
X1337_DOMAIN=1377x.to
TGX_DOMAIN=torrentgalaxy.to
